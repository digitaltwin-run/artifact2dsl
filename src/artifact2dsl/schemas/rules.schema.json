{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digitaltwin.run/schemas/artifact2dsl/rules/v1",
  "title": "Explicit cross-artifact comparison rules",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "rules"],
  "properties": {
    "schema_id": {"const": "artifact2dsl.rules/v1"},
    "rules": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "left", "right"],
        "properties": {
          "id": {"type": "string", "minLength": 1}, "namespace": {"type": "string"},
          "subject": {"type": "string"}, "predicate": {"type": "string"},
          "operator": {"enum": ["exact", "numeric"]}, "tolerance": {"type": "number", "minimum": 0},
          "left": {"$ref": "#/$defs/selector"}, "right": {"$ref": "#/$defs/selector"}
        }
      }
    }
  },
  "$defs": {
    "selector": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "source": {"type": "string"}, "converter": {"type": "string"}, "namespace": {"type": "string"},
        "subject": {"type": "string"}, "predicate": {"type": "string"}
      }
    }
  }
}
